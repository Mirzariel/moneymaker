# Created automatically as .env on first start; the setup page in the browser fills it in.
# You can also edit .env by hand. NEVER commit .env.

# Tokocrypto API key: enable ONLY "Read" + "Spot Trading". NEVER enable withdrawal.
TOKO_API_KEY=
TOKO_API_SECRET=

# true = real money on your Tokocrypto account. false = paper trading (simulated orders on live prices).
# Even when true, the bot only starts trading after you send /resume (or `moneymaker resume`).
LIVE_TRADING=true

# Telegram: create a bot with @BotFather; the setup page can detect your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard access code. Generated automatically on first start.
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8000

# Dead-man's switch: https://healthchecks.io ping URL (alerts you if the laptop/bot dies).
HEALTHCHECK_URL=

CONFIG_PATH=config.yaml
# Leave empty: data/live.db or data/paper.db is chosen from LIVE_TRADING (they are never mixed).
DB_PATH=
PAPER_STATE_PATH=data/paper_state.json

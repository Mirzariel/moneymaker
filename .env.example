# Copy to .env and fill in. NEVER commit .env.

# Tokocrypto API key: enable ONLY "Read" + "Spot Trading". NEVER enable withdrawal.
TOKO_API_KEY=
TOKO_API_SECRET=

# true = real money on your Tokocrypto account. false = paper trading (simulated orders on live prices).
# Even when true, the bot only starts trading after you send /resume (or `moneymaker resume`).
LIVE_TRADING=true

# Telegram: create a bot with @BotFather, get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard API token (>= 16 random chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8000

# Dead-man's switch: https://healthchecks.io ping URL (alerts you if the laptop/bot dies).
HEALTHCHECK_URL=

CONFIG_PATH=config.yaml
# Use a different DB for live vs paper (the bot refuses to mix them).
DB_PATH=data/live.db
PAPER_STATE_PATH=data/paper_state.json
